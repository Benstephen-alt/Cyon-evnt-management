generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                             String                        @id @default(uuid())
  email                          String?                       @unique
  loginId                        String?                       @unique
  passwordHash                   String
  role                           UserRole
  isActive                       Boolean                       @default(true)
  lastLogin                      DateTime?
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt
  accommodationAllocations       Accommodation[]
  admin                          Admin?
  announcements                  Announcement[]
  auditLogs                      AuditLog[]
  committeeAssignmentsCreated    CommitteeAssignment[]         @relation("CommitteeAssignmentBy")
  committeeMember                CommitteeMember?
  delegateCheckIns               Delegate[]                    @relation("DelegateCheckIn")
  delegateDrafts                 DelegateDraft[]
  fundReleases                   FundRelease[]                 @relation("FundReleasedBy")
  incomeRecords                  IncomeRecord[]
  parishAccount                  ParishAccount?
  parishArrivalsChecked          ParishArrival[]
  arrivalExtraAllocations        ArrivalExtraDelegate[]
  searchHistory                  SearchHistory[]
  vendors                        Vendor[]
  manualParishRegistrations      ManualParishRegistration[]
  manualAccommodationAllocations ManualDelegateAccommodation[]
  gatePassesCheckedOut           GatePass[]                    @relation("GatePassCheckedOutBy")
  gatePassesCheckedIn            GatePass[]                    @relation("GatePassCheckedInBy")
  notificationCampaigns          NotificationCampaign[]
  feedingRequestsReviewed        FeedingRequest[]              @relation("FeedingRequestReviewedBy")
}

model Admin {
  id                String   @id @default(uuid())
  userId            String   @unique
  fullName          String
  phoneNumber       String?
  adminPortalAccess Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id                           String                     @id @default(uuid())
  eventName                    String
  theme                        String?
  year                         Int
  registrationFee              Decimal                    @db.Decimal(12, 2)
  startDate                    DateTime
  endDate                      DateTime
  registrationOpen             Boolean                    @default(true)
  delegateRegistrationOpen     Boolean                    @default(true)
  isActive                     Boolean                    @default(true)
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  delegateRegistrationDeadline DateTime?
  announcements                Announcement[]
  budgets                      Budget[]
  committees                   Committee[]
  complaints                   Complaint[]
  deaneries                    Deanery[]
  delegates                    Delegate[]
  delegateDrafts               DelegateDraft[]
  expenses                     Expense[]
  fundReleases                 FundRelease[]
  hostels                      Hostel[]
  incomeRecords                IncomeRecord[]
  parishAccounts               ParishAccount[]
  parishArrivals               ParishArrival[]
  vendors                      Vendor[]
  manualRegistrations          ManualParishRegistration[]
  gatePasses                   GatePass[]
  committeeBadges              CommitteeBadge[]
  committeeBadgeSequence       Int                        @default(0)
  privateDelegateSequence      Int                        @default(0)
  notificationCampaigns        NotificationCampaign[]
  feedingRequests              FeedingRequest[]
  privateDelegates             PrivateDelegate[]
}

model PrivateDelegate {
  id             String   @id @default(uuid())
  eventId        String
  delegateNumber String   @unique
  fullName       String
  phoneNumber    String?
  gender         Gender?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([eventId, fullName])
}

model Deanery {
  id                  String                     @id @default(uuid())
  name                String
  eventId             String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  event               Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  delegates           Delegate[]
  delegateDrafts      DelegateDraft[]
  parishes            Parish[]
  manualRegistrations ManualParishRegistration[]

  @@unique([eventId, name])
}

model Parish {
  id                  String                     @id @default(uuid())
  parishCode          String                     @unique
  parishName          String
  deaneryId           String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  accessCode          String                     @unique
  complaints          Complaint[]
  delegates           Delegate[]
  delegateDrafts      DelegateDraft[]
  deanery             Deanery                    @relation(fields: [deaneryId], references: [id], onDelete: Cascade)
  parishAccounts      ParishAccount[]
  arrivals            ParishArrival[]
  manualRegistrations ManualParishRegistration[]

  @@unique([deaneryId, parishName])
}

model ParishAccount {
  id                       String             @id @default(uuid())
  userId                   String             @unique
  parishId                 String
  eventId                  String
  accessCodeHash           String
  paymentStatus            PaymentStatus      @default(PENDING)
  receiptUrl               String?
  approvedAt               DateTime?
  isActivated              Boolean            @default(false)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  presidentName            String
  presidentPhoneNumber     String
  delegateSubmissionLocked Boolean            @default(false)
  registrationStatus       RegistrationStatus @default(PENDING)
  isSuperAdminManaged      Boolean            @default(false)
  incomeRecord             IncomeRecord?
  event                    Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  parish                   Parish             @relation(fields: [parishId], references: [id], onDelete: Cascade)
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([parishId, eventId])
}

model DelegateDraft {
  id              String   @id @default(uuid())
  fullName        String
  gender          Gender
  age             Int?
  phoneNumber     String
  photoUrl        String
  parishId        String
  deaneryId       String
  eventId         String
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  deanery         Deanery  @relation(fields: [deaneryId], references: [id], onDelete: Cascade)
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  parish          Parish   @relation(fields: [parishId], references: [id], onDelete: Cascade)

  @@index([parishId])
  @@index([eventId])
}

model ManualParishRegistration {
  id String @id @default(cuid())

  registrationCode String @unique

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  deaneryId String
  deanery   Deanery @relation(fields: [deaneryId], references: [id])

  parishId String
  parish   Parish @relation(fields: [parishId], references: [id])

  presidentName  String
  presidentPhone String

  totalDelegates  Int
  maleDelegates   Int @default(0)
  femaleDelegates Int @default(0)

  delegatesOutside         Int       @default(0)
  accommodationAllocatedAt DateTime?

  amountPaid Decimal @db.Decimal(12, 2)

  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id])

  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  gatePasses     GatePass[]
  accommodations ManualDelegateAccommodation[]

  @@unique([eventId, parishId])
}

model GatePass {
  id String @id @default(uuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  delegateId String?
  delegate   Delegate? @relation(fields: [delegateId], references: [id], onDelete: Cascade)

  manualRegistrationId String?
  manualRegistration   ManualParishRegistration? @relation(fields: [manualRegistrationId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  checkedOutAt DateTime  @default(now())
  checkedInAt  DateTime?

  type GatePassType

  checkedOutByUserId String
  checkedOutBy       User   @relation("GatePassCheckedOutBy", fields: [checkedOutByUserId], references: [id])

  checkedInByUserId String?
  checkedInBy       User?   @relation("GatePassCheckedInBy", fields: [checkedInByUserId], references: [id])

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([delegateId])
  @@index([manualRegistrationId])
  @@index([checkedOutAt])
  @@index([checkedInAt])
}

model Committee {
  id            String                @id @default(uuid())
  committeeName String
  eventId       String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  description   String?
  permissions   CommitteePermission[]
  budgets       Budget[]
  event         Event                 @relation(fields: [eventId], references: [id])
  assignments   CommitteeAssignment[]
  expenses      Expense[]
  fundReleases  FundRelease[]
  badges        CommitteeBadge[]

  @@unique([eventId, committeeName])
}

model CommitteeMember {
  id             String                @id @default(uuid())
  userId         String                @unique
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  accommodations Accommodation[]
  assignments    CommitteeAssignment[]
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  fundReleases   FundRelease[]
  badges         CommitteeBadge[]
  feedingProfile FeedingProfile?
}

model FeedingProfile {
  id                String           @id @default(uuid())
  committeeMemberId String           @unique
  fullName          String
  committeeName     String
  bankName          String
  accountNumber     String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  committeeMember   CommitteeMember  @relation(fields: [committeeMemberId], references: [id], onDelete: Cascade)
  requests          FeedingRequest[]

  @@index([committeeName])
}

model FeedingRequest {
  id               String               @id @default(uuid())
  eventId          String
  feedingProfileId String
  status           FeedingRequestStatus @default(PENDING)
  amount           Int                  @default(1000)
  isSecurityCollective Boolean           @default(false)
  rejectionReason  String?
  requestedAt      DateTime             @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  event            Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  feedingProfile   FeedingProfile       @relation(fields: [feedingProfileId], references: [id], onDelete: Cascade)
  reviewedBy       User?                @relation("FeedingRequestReviewedBy", fields: [reviewedByUserId], references: [id])
  expense          Expense?

  @@index([eventId, requestedAt])
  @@index([feedingProfileId, requestedAt])
  @@index([eventId, status])
  @@index([eventId, isSecurityCollective, requestedAt])
}

model CommitteeBadge {
  id                String          @id @default(uuid())
  eventId           String
  committeeId       String
  committeeMemberId String
  badgeNumber       String          @unique
  fullName          String
  photoUrl          String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  event             Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  committee         Committee       @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  committeeMember   CommitteeMember @relation(fields: [committeeMemberId], references: [id], onDelete: Cascade)

  @@unique([eventId, committeeMemberId])
  @@index([eventId])
  @@index([committeeId])
  @@index([committeeMemberId])
}

model CommitteeAssignment {
  id                String          @id @default(uuid())
  committeeId       String
  committeeMemberId String
  assignedByUserId  String?
  assignedAt        DateTime        @default(now())
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  assignedBy        User?           @relation("CommitteeAssignmentBy", fields: [assignedByUserId], references: [id])
  committee         Committee       @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  committeeMember   CommitteeMember @relation(fields: [committeeMemberId], references: [id], onDelete: Cascade)

  @@unique([committeeId, committeeMemberId])
  @@index([committeeId])
  @@index([committeeMemberId])
}

model Budget {
  id          String    @id @default(uuid())
  eventId     String
  committeeId String
  amount      Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, committeeId])
}

model FundRelease {
  id                String               @id @default(uuid())
  eventId           String
  committeeId       String
  committeeMemberId String
  amount            Decimal              @db.Decimal(12, 2)
  receiptUrl        String?
  createdAt         DateTime             @default(now())
  authority         FundReleaseAuthority
  recipientName     String
  releasedAt        DateTime             @default(now())
  releasedByUserId  String
  remarks           String?
  updatedAt         DateTime             @updatedAt
  committee         Committee            @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  committeeMember   CommitteeMember      @relation(fields: [committeeMemberId], references: [id])
  event             Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  releasedBy        User                 @relation("FundReleasedBy", fields: [releasedByUserId], references: [id])

  @@index([eventId])
  @@index([committeeId])
  @@index([committeeMemberId])
  @@index([releasedByUserId])
}

model Expense {
  id                String          @id @default(uuid())
  eventId           String
  committeeId       String
  committeeMemberId String
  category          ExpenseCategory
  amount            Decimal         @db.Decimal(12, 2)
  description       String
  receiptType       ReceiptType
  receiptUrl        String?
  createdAt         DateTime        @default(now())
  expenseName       String
  feedingRequestId  String?         @unique
  committee         Committee       @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  committeeMember   CommitteeMember @relation(fields: [committeeMemberId], references: [id], onDelete: Cascade)
  event             Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  feedingRequest    FeedingRequest?  @relation(fields: [feedingRequestId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([committeeId])
  @@index([category])
}

model Delegate {
  id                String          @id @default(uuid())
  eventId           String
  parishId          String
  fullName          String
  age               Int?
  phoneNumber       String
  photoUrl          String
  qrCode            String?
  updatedAt         DateTime        @updatedAt
  dateOfBirth       DateTime?
  deaneryId         String
  deaneryName       String
  delegateNumber    String          @unique
  isCheckedIn       Boolean         @default(false)
  parishName        String
  checkedInAt       DateTime?
  checkedInByUserId String?
  createdAt         DateTime        @default(now())
  gender            Gender
  accommodation     Accommodation?
  checkedInBy       User?           @relation("DelegateCheckIn", fields: [checkedInByUserId], references: [id])
  deanery           Deanery         @relation(fields: [deaneryId], references: [id], onDelete: Cascade)
  event             Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  parish            Parish          @relation(fields: [parishId], references: [id], onDelete: Cascade)
  searchHistories   SearchHistory[]
  gatePasses        GatePass[]
}

model Hostel {
  id         String   @id @default(uuid())
  eventId    String
  hostelName String
  gender     Gender
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  halls      Hall[]
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, hostelName])
}

model Hall {
  id        String   @id @default(uuid())
  hostelId  String
  hallName  String
  totalBeds Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  beds      Bed[]
  hostel    Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@unique([hostelId, hallName])
}

model Bed {
  id                  String                       @id @default(uuid())
  hallId              String
  bedNumber           Int
  isOccupied          Boolean                      @default(false)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  accommodation       Accommodation?
  manualAccommodation ManualDelegateAccommodation?
  arrivalExtraAccommodation ArrivalExtraDelegate?
  hall                Hall                         @relation(fields: [hallId], references: [id], onDelete: Cascade)

  @@unique([hallId, bedNumber])
}

model ManualDelegateAccommodation {
  id                String                   @id @default(uuid())
  registrationId    String
  bedId             String                   @unique
  gender            Gender
  delegatePosition  Int
  allocatedByUserId String
  allocatedAt       DateTime                 @default(now())
  registration      ManualParishRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  bed               Bed                      @relation(fields: [bedId], references: [id], onDelete: Cascade)
  allocatedBy       User                     @relation(fields: [allocatedByUserId], references: [id])

  @@unique([registrationId, gender, delegatePosition])
  @@index([registrationId])
  @@index([allocatedByUserId])
}

model Accommodation {
  id                String           @id @default(uuid())
  delegateId        String           @unique
  bedId             String           @unique
  allocatedByUserId String
  allocatedAt       DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  committeeMemberId String?
  allocatedBy       User             @relation(fields: [allocatedByUserId], references: [id])
  bed               Bed              @relation(fields: [bedId], references: [id], onDelete: Cascade)
  committeeMember   CommitteeMember? @relation(fields: [committeeMemberId], references: [id])
  delegate          Delegate         @relation(fields: [delegateId], references: [id], onDelete: Cascade)

  @@index([allocatedByUserId])
}

model Announcement {
  id              String   @id @default(uuid())
  eventId         String
  createdByUserId String
  title           String
  message         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model NotificationCampaign {
  id              String                  @id @default(uuid())
  eventId         String
  message         String
  audience        NotificationAudience
  status          NotificationStatus      @default(PENDING)
  recipientCount  Int                     @default(0)
  acceptedCount   Int                     @default(0)
  failedCount     Int                     @default(0)
  invalidCount    Int                     @default(0)
  providerCost    String?
  createdByUserId String
  createdAt       DateTime                @default(now())
  completedAt     DateTime?
  event           Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy       User                    @relation(fields: [createdByUserId], references: [id])
  recipients      NotificationRecipient[]

  @@index([eventId])
  @@index([createdByUserId])
  @@index([createdAt])
}

model NotificationRecipient {
  id                String                    @id @default(uuid())
  campaignId        String
  phoneNumber       String
  recipientName     String?
  recipientType     NotificationRecipientType
  providerMessageId String?
  providerStatus    String?
  deliveryStatus    SmsDeliveryStatus         @default(QUEUED)
  failureReason     String?
  providerCost      String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  campaign          NotificationCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([providerMessageId])
}

model Complaint {
  id         String          @id @default(uuid())
  eventId    String
  parishId   String
  title      String
  message    String
  status     ComplaintStatus @default(PENDING)
  adminReply String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  parish     Parish          @relation(fields: [parishId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([parishId])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  module      String
  action      String
  description String
  ipAddress   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

model SearchHistory {
  id               String   @id @default(uuid())
  delegateId       String
  searchedByUserId String
  createdAt        DateTime @default(now())
  delegate         Delegate @relation(fields: [delegateId], references: [id], onDelete: Cascade)
  searchedBy       User     @relation(fields: [searchedByUserId], references: [id], onDelete: Cascade)

  @@index([delegateId])
  @@index([searchedByUserId])
}

model ParishArrival {
  id                String    @id @default(uuid())
  eventId           String
  parishId          String
  arrived           Boolean   @default(false)
  arrivedAt         DateTime?
  checkedInByUserId String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  additionalMaleDelegates   Int @default(0)
  additionalFemaleDelegates Int @default(0)
  checkedInBy       User      @relation(fields: [checkedInByUserId], references: [id])
  event             Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  parish            Parish    @relation(fields: [parishId], references: [id], onDelete: Cascade)
  additionalDelegates ArrivalExtraDelegate[]

  @@unique([eventId, parishId])
}

model ArrivalExtraDelegate {
  id                String        @id @default(uuid())
  parishArrivalId   String
  bedId             String?       @unique
  gender            Gender
  delegatePosition  Int
  allocatedByUserId String
  allocatedAt       DateTime      @default(now())
  parishArrival     ParishArrival @relation(fields: [parishArrivalId], references: [id], onDelete: Cascade)
  bed               Bed?          @relation(fields: [bedId], references: [id], onDelete: SetNull)
  allocatedBy       User          @relation(fields: [allocatedByUserId], references: [id])

  @@unique([parishArrivalId, gender, delegatePosition])
  @@index([parishArrivalId])
  @@index([allocatedByUserId])
}

model IncomeRecord {
  id               String         @id @default(cuid())
  eventId          String
  source           IncomeSource
  payerName        String
  amount           Decimal
  receiptUrl       String?
  remarks          String?
  recordedByUserId String
  parishAccountId  String?        @unique
  createdAt        DateTime       @default(now())
  event            Event          @relation(fields: [eventId], references: [id])
  recordedBy       User           @relation(fields: [recordedByUserId], references: [id])
  parishAccount    ParishAccount? @relation(fields: [parishAccountId], references: [id], onDelete: SetNull)
}

model Vendor {
  id               String         @id @default(uuid())
  vendorCode       String         @unique
  eventId          String
  businessName     String
  ownerName        String
  phoneNumber      String
  category         VendorCategory
  description      String?
  amountPaid       Decimal        @db.Decimal(12, 2)
  remarks          String?
  recordedByUserId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  event            Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recordedBy       User           @relation(fields: [recordedByUserId], references: [id])
}

enum GatePassType {
  ONLINE
  MANUAL
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PARISH
  COMMITTEE
}

enum FeedingRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationAudience {
  DELEGATES
  PRESIDENTS
  SEMINARIANS
  MIXED
}

enum NotificationRecipientType {
  DELEGATE
  PRESIDENT
  SEMINARIAN
}

enum NotificationStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
}

enum SmsDeliveryStatus {
  QUEUED
  SENT
  FAILED
  DELIVERED
  REJECTED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  ACCOMMODATION
  MEDICAL
  PUBLICITY
  PRINTING
  EQUIPMENT
  LABOUR
  FUEL
  UTILITY
  MISC
}

enum ReceiptType {
  RECEIPT
  CASH
}

enum Gender {
  MALE
  FEMALE
}

enum AttendanceStatus {
  NOT_ARRIVED
  ARRIVED
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

enum CommitteePermission {
  SCAN_PARISH
  CONFIRM_PARISH_ARRIVAL
  SCAN_DELEGATE
  CHECKIN_DELEGATE
  ALLOCATE_ACCOMMODATION
  MOVE_ACCOMMODATION
  REGISTER_DELEGATE
  EDIT_DELEGATE
  VERIFY_PAYMENT
  APPROVE_PAYMENT
  VIEW_REPORTS
  CREATE_BUDGET
  UPDATE_BUDGET
  DELETE_BUDGET
  VIEW_FINANCE_DASHBOARD
  CREATE_FUND_RELEASE
  VIEW_FUND_RELEASES
  DELETE_FUND_RELEASE
  CREATE_EXPENSE
  VIEW_EXPENSES
  UPDATE_EXPENSE
  DELETE_EXPENSE
}

enum FundReleaseAuthority {
  DIOCESAN_PRESIDENT
  GENERAL_COMMITTEE_CHAIRMAN
  CHAPLAIN
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_SUBMITTED
}

enum IncomeSource {
  PARISH_REGISTRATION
  VENDOR_REGISTRATION
  DONATION
  SPONSORSHIP
  OTHER
}

